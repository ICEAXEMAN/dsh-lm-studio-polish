{
  "name": "dsh-lm-studio-polish",
  "version": "0.1.0",
  "private": true,
  "description": "LM Studio 文风润色：DSH 负责思考，本地模型只负责说话。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "locale",
    "docs",
    "tools",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "lm-studio",
    "rewrite",
    "style"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "MIT"
}
